rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // مِراس يعتمد على خادم Cloud Run كمصدر صلاحية وحيد. الخادم يتصل عبر
    // Firebase Admin وIAM، لذلك لا يحتاج أي وصول مباشر من المتصفح.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
