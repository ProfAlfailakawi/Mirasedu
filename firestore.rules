rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // رسائل التواصل: يُسمح بالإرسال فقط.
    // القراءة والتعديل والحذف للمشرف المصادَق عليه حصراً.
    match /messages/{messageId} {
      allow create: if isValidMessage();
      allow read, update, delete: if isAdmin();
    }

    // المشتركون في النشرة: إضافة فقط.
    match /subscribers/{email} {
      allow create: if isValidEmail(request.resource.data.email);
      allow read, update, delete: if isAdmin();
    }

    // محتوى لوحة التحكم /admin: قراءة عامة (يعرضه الموقع)،
    // والكتابة والتعديل والحذف للمشرف المصادَق عليه حصراً.
    match /site_articles/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /content_overrides/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /site_books/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /site_papers/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /site_media/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /cv_overrides/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /site_questions/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /site_upcoming/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /site_picks/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    // رادار الشبكة: يكتبه سكربت الالتقاط اليومي بحساب الخدمة
    // (حساب الخدمة يتجاوز القواعد) — للزوار قراءة فقط.
    match /site_radar/{id} {
      allow read: if true;
      allow write: if false;
    }

    // تقرير شهري تنشئه المهمة المجدولة بحساب الخدمة (يتجاوز القواعد).
    // يظهر داخل لوحة المؤشرات للمشرف فقط، ولا يستطيع عميل المتصفح كتابته.
    match /admin_reports/{month} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // تقرير حارس الجودة الأسبوعي — يكتبه السكربت المجدول بحساب الخدمة، للمشرف قراءةً.
    match /site_health/{date} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // عدادات المشاهدة في مجموعة واحدة:
    //   total:<encoded-path>             إجمالي الصفحة
    //   day:YYYY-MM-DD:<encoded-path>    عداد يومي لاتجاه آخر 7 أيام
    // القراءة للمشرف فقط. الزائر لا يستطيع إلا إنشاء العداد من 1 أو زيادته 1.
    match /views/{id} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin() || isValidViewCreate(id);
      allow update: if isAdmin() || isValidViewUpdate(id);
    }

    // كل ما عدا ذلك: مغلق.
    match /{document=**} {
      allow read, write: if false;
    }
  }

  function isValidEmail(e) {
    return e is string && e.size() <= 200 && e.matches('^[^@]+@[^@]+\\.[^@]+$');
  }

  function isAdmin() {
    return request.auth != null && request.auth.token.admin == true;
  }

  function isValidViewId(id) {
    return id.size() <= 512
      && (id.matches('^total:.+$')
        || id.matches('^day:[0-9]{4}-[0-9]{2}-[0-9]{2}:.+$'));
  }

  function hasValidViewFields(d) {
    return d.keys().hasOnly(['count', 'title', 'updatedAt'])
      && d.count is int
      && d.title is string && d.title.size() > 0 && d.title.size() <= 300
      && d.updatedAt == request.time;
  }

  function isValidViewCreate(id) {
    return isValidViewId(id)
      && hasValidViewFields(request.resource.data)
      && request.resource.data.count == 1;
  }

  function isValidViewUpdate(id) {
    return isValidViewId(id)
      && hasValidViewFields(request.resource.data)
      && request.resource.data.count == resource.data.count + 1
      && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['count', 'updatedAt']);
  }

  function isValidMessage() {
    let d = request.resource.data;
    return d.keys().hasOnly(['name', 'email', 'topic', 'message', 'createdAt'])
      && d.name is string && d.name.size() > 1 && d.name.size() <= 80
      && isValidEmail(d.email)
      && d.topic in ['استشارة', 'محاضرة أو ورشة', 'لقاء إعلامي', 'أخرى']
      && d.message is string && d.message.size() > 10 && d.message.size() <= 3000
      && d.createdAt == request.time;
  }
}
