# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public HTTPS URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, API endpoints, and FCM push-click links.
APP_URL="MY_APP_URL"

# Firebase Cloud Messaging (FCM) public web config.
# These values are public identifiers; do not place service-account secrets here.
FIREBASE_API_KEY="MY_FIREBASE_WEB_API_KEY"
FIREBASE_AUTH_DOMAIN="MY_PROJECT.firebaseapp.com"
FIREBASE_PROJECT_ID="MY_FIREBASE_PROJECT_ID"
FIREBASE_STORAGE_BUCKET="MY_PROJECT.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="MY_SENDER_ID"
FIREBASE_APP_ID="MY_FIREBASE_WEB_APP_ID"
FIREBASE_MEASUREMENT_ID=""
FIREBASE_FCM_VAPID_KEY="MY_PUBLIC_WEB_PUSH_VAPID_KEY"

# Server-only FCM sender credential. Required for real Push delivery from the server.
# Provide the Firebase service-account JSON as raw JSON or base64 JSON in production secrets only.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Bootstrap login credentials (server-only secrets — never commit real values).
# Each holds the SHA-256 of the chosen password, as 64 hex chars (a "sha256:" prefix is
# optional). Generate one with:
#   node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" "your-password"
# MIRAS_ADMIN_PASSWORD_HASH  -> the super-admin account (ah.alfailakawi@paaet.edu.kw).
# MIRAS_TEACHER_PASSWORD_HASH -> the bootstrap teacher accounts.
# If a variable is left unset, its bootstrap account is disabled (cannot log in) until provisioned.
MIRAS_ADMIN_PASSWORD_HASH=""
MIRAS_TEACHER_PASSWORD_HASH=""
