{
  "appId": "kw.edu.mirasedu.app",
  "appName": "مِراس",
  "webDir": "www",
  "server": {
    "url": "https://mirasedu.web.app",
    "errorPath": "offline.html",
    "allowNavigation": [
      "mirasedu.web.app",
      "meras-320eb.firebaseapp.com",
      "*.googleapis.com"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#FFFFFF",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  },
  "android": {
    "backgroundColor": "#FFFFFF",
    "allowMixedContent": false
  }
}
